# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# Leave empty to run without Google sign-in (progress stays in this browser only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: this email is greeted as "Admin" (display only).
VITE_ADMIN_EMAIL=

# Google Drive API key (Google Cloud: enable "Google Drive API", create an API key and restrict it to this website).
# Needed for Admin Features to read linked Drive folders live. Folders must be shared as "Anyone with the link".
VITE_DRIVE_API_KEY=

# ---- MCP connector for Claude / ChatGPT (server-side only: set these in Vercel, never with a VITE_ prefix) ----
# Long random secret; it goes in the connector URL: https://<your-site>/mcp/<MCP_SECRET>
MCP_SECRET=
# Optional: Firebase service-account JSON (one line) so the MCP can also list resources you added by hand.
FIREBASE_SERVICE_ACCOUNT=
